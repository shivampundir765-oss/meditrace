# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/meditrace

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_prod_123456
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_prod_654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Cloudinary (Prescription & Scan Image Storage)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz

# Email (Nodemailer - Test Mode)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=test@ethereal.email
SMTP_PASS=testpass123
EMAIL_FROM=no-reply@meditrace.health

# Payments (Razorpay / Stripe Test Mode)
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_test_dummy_key_id
RAZORPAY_KEY_SECRET=rzp_test_dummy_secret
